generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName              String                 @map("full_name") @db.VarChar(160)
  email                 String                 @db.VarChar(320)
  whatsappNumber        String?                @map("whatsapp_number") @db.VarChar(32)
  passwordHash          String                 @map("password_hash")
  isSuperAdmin          Boolean                @default(false) @map("is_super_admin")
  status                String                 @default("active") @db.VarChar(24)
  lastLoginAt           DateTime?              @map("last_login_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(3)
  memberships           TenantUser[]           @relation("membership_user")
  createdMemberships    TenantUser[]           @relation("membership_creator")
  createdEvents         Event[]                @relation("event_creator")
  updatedEvents         Event[]                @relation("event_updater")
  eventAssignments      EventStaffAssignment[]
  checkIns              CheckIn[]              @relation("check_in_actor")
  voidedCheckIns        CheckIn[]              @relation("check_in_voider")
  auditLogs             AuditLog[]
  authSessions          AuthSession[]
  passwordResetTokens   PasswordResetToken[]
  manualSettledPayments Payment[]              @relation("payment_manual_settler")

  @@index([status])
  @@map("users")
}

model Tenant {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                 @db.VarChar(160)
  slug                String                 @db.VarChar(120)
  logoUrl             String?                @map("logo_url")
  primaryColor        String?                @map("primary_color") @db.VarChar(16)
  email               String?                @db.VarChar(320)
  whatsappNumber      String?                @map("whatsapp_number") @db.VarChar(32)
  address             String?
  customDomain        String?                @map("custom_domain") @db.VarChar(255)
  status              String                 @default("active") @db.VarChar(24)
  settingsJson        Json                   @default("{}") @map("settings_json")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(3)
  users               TenantUser[]
  events              Event[]
  eventAssignments    EventStaffAssignment[]
  ticketTypes         TicketType[]
  addOns              AddOn[]
  addOnOptions        AddOnOption[]
  ticketTypeAddOns    TicketTypeAddOn[]
  formFields          FormField[]
  formFieldOptions    FormFieldOption[]
  registrations       Registration[]
  registrationItems   RegistrationItem[]
  registrationAddOns  RegistrationAddOn[]
  registrationAnswers RegistrationAnswer[]
  tickets             Ticket[]
  checkIns            CheckIn[]
  paymentConfigs      PaymentConfig[]
  payments            Payment[]
  webhookEvents       PaymentWebhookEvent[]
  auditLogs           AuditLog[]

  @@unique([slug])
  @@index([status])
  @@map("tenants")
}

model TenantUser {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String    @db.VarChar(32)
  status    String    @default("active") @db.VarChar(24)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation("membership_user", fields: [userId], references: [id])
  creator   User?     @relation("membership_creator", fields: [createdBy], references: [id])

  @@index([tenantId, status])
  @@index([userId, status])
  @@map("tenant_users")
}

model Event {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  name                String                 @db.VarChar(200)
  slug                String                 @db.VarChar(140)
  shortDescription    String?                @map("short_description") @db.VarChar(500)
  description         String?
  bannerUrl           String?                @map("banner_url")
  locationType        String                 @default("offline") @map("location_type") @db.VarChar(24)
  locationName        String?                @map("location_name") @db.VarChar(200)
  locationAddress     String?                @map("location_address")
  meetingUrl          String?                @map("meeting_url")
  startAt             DateTime               @map("start_at") @db.Timestamptz(3)
  endAt               DateTime               @map("end_at") @db.Timestamptz(3)
  timezone            String                 @default("Asia/Jakarta") @db.VarChar(64)
  registrationStartAt DateTime               @map("registration_start_at") @db.Timestamptz(3)
  registrationEndAt   DateTime               @map("registration_end_at") @db.Timestamptz(3)
  capacity            Int?
  organizerName       String?                @map("organizer_name") @db.VarChar(160)
  organizerContact    String?                @map("organizer_contact") @db.VarChar(160)
  termsText           String?                @map("terms_text")
  privacyText         String?                @map("privacy_text")
  status              String                 @default("draft") @db.VarChar(24)
  publishedAt         DateTime?              @map("published_at") @db.Timestamptz(3)
  createdBy           String                 @map("created_by") @db.Uuid
  updatedBy           String?                @map("updated_by") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(3)
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  creator             User                   @relation("event_creator", fields: [createdBy], references: [id])
  updater             User?                  @relation("event_updater", fields: [updatedBy], references: [id])
  staffAssignments    EventStaffAssignment[]
  ticketTypes         TicketType[]
  addOns              AddOn[]
  formFields          FormField[]
  registrations       Registration[]
  tickets             Ticket[]
  checkIns            CheckIn[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("events")
}

model EventStaffAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, eventId, userId])
  @@index([userId])
  @@map("event_staff_assignments")
}

model TicketType {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  eventId           String             @map("event_id") @db.Uuid
  name              String             @db.VarChar(160)
  slug              String             @db.VarChar(120)
  description       String?
  price             Decimal            @default(0) @db.Decimal(18, 2)
  currency          String             @default("IDR") @db.Char(3)
  quota             Int?
  minPerOrder       Int                @default(1) @map("min_per_order")
  maxPerOrder       Int                @default(10) @map("max_per_order")
  saleStartAt       DateTime?          @map("sale_start_at") @db.Timestamptz(3)
  saleEndAt         DateTime?          @map("sale_end_at") @db.Timestamptz(3)
  visibility        String             @default("public") @db.VarChar(24)
  accessCodeHash    String?            @map("access_code_hash")
  sortOrder         Int                @default(0) @map("sort_order")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  event             Event              @relation(fields: [eventId], references: [id])
  addOnLinks        TicketTypeAddOn[]
  formFields        FormField[]
  registrationItems RegistrationItem[]

  @@index([tenantId, eventId, isActive])
  @@map("ticket_types")
}

model AddOn {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  eventId            String              @map("event_id") @db.Uuid
  name               String              @db.VarChar(160)
  slug               String              @db.VarChar(120)
  description        String?
  price              Decimal             @default(0) @db.Decimal(18, 2)
  currency           String              @default("IDR") @db.Char(3)
  quota              Int?
  selectionType      String              @default("quantity") @map("selection_type") @db.VarChar(24)
  minQuantity        Int                 @default(0) @map("min_quantity")
  maxQuantity        Int                 @default(1) @map("max_quantity")
  isRequired         Boolean             @default(false) @map("is_required")
  sortOrder          Int                 @default(0) @map("sort_order")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  event              Event               @relation(fields: [eventId], references: [id])
  options            AddOnOption[]
  ticketTypeLinks    TicketTypeAddOn[]
  registrationAddOns RegistrationAddOn[]

  @@index([tenantId, eventId, isActive])
  @@map("add_ons")
}

model AddOnOption {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  addOnId            String              @map("add_on_id") @db.Uuid
  label              String              @db.VarChar(160)
  value              String              @db.VarChar(120)
  priceAdjustment    Decimal             @default(0) @map("price_adjustment") @db.Decimal(18, 2)
  quota              Int?
  sortOrder          Int                 @default(0) @map("sort_order")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  addOn              AddOn               @relation(fields: [addOnId], references: [id])
  registrationAddOns RegistrationAddOn[]

  @@index([tenantId, addOnId, isActive])
  @@map("add_on_options")
}

model TicketTypeAddOn {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  addOnId      String     @map("add_on_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  addOn        AddOn      @relation(fields: [addOnId], references: [id])

  @@unique([tenantId, ticketTypeId, addOnId])
  @@index([addOnId])
  @@map("ticket_type_add_ons")
}

model FormField {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  eventId              String               @map("event_id") @db.Uuid
  ticketTypeId         String?              @map("ticket_type_id") @db.Uuid
  fieldKey             String               @map("field_key") @db.VarChar(80)
  label                String               @db.VarChar(160)
  fieldType            String               @map("field_type") @db.VarChar(32)
  placeholder          String?              @db.VarChar(255)
  helpText             String?              @map("help_text")
  defaultValueJson     Json?                @map("default_value_json")
  validationJson       Json?                @map("validation_json")
  conditionalLogicJson Json?                @map("conditional_logic_json")
  sortOrder            Int                  @default(0) @map("sort_order")
  isRequired           Boolean              @default(false) @map("is_required")
  isSystem             Boolean              @default(false) @map("is_system")
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz(3)
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  event                Event                @relation(fields: [eventId], references: [id])
  ticketType           TicketType?          @relation(fields: [ticketTypeId], references: [id])
  options              FormFieldOption[]
  answers              RegistrationAnswer[]

  @@index([tenantId, eventId, isActive])
  @@map("form_fields")
}

model FormFieldOption {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  formFieldId String    @map("form_field_id") @db.Uuid
  label       String    @db.VarChar(160)
  value       String    @db.VarChar(120)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  formField   FormField @relation(fields: [formFieldId], references: [id])

  @@index([tenantId, formFieldId, isActive])
  @@map("form_field_options")
}

model Registration {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  eventId          String               @map("event_id") @db.Uuid
  registrationCode String               @unique @map("registration_code") @db.VarChar(40)
  fullName         String               @map("full_name") @db.VarChar(160)
  whatsappNumber   String               @map("whatsapp_number") @db.VarChar(32)
  email            String               @db.VarChar(320)
  status           String               @default("pending") @db.VarChar(32)
  subtotalAmount   Decimal              @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  addOnAmount      Decimal              @default(0) @map("add_on_amount") @db.Decimal(18, 2)
  totalAmount      Decimal              @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency         String               @default("IDR") @db.Char(3)
  idempotencyKey   String               @map("idempotency_key") @db.VarChar(160)
  source           String               @default("web") @db.VarChar(24)
  registeredAt     DateTime             @default(now()) @map("registered_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  event            Event                @relation(fields: [eventId], references: [id])
  items            RegistrationItem[]
  addOns           RegistrationAddOn[]
  answers          RegistrationAnswer[]
  tickets          Ticket[]
  payments         Payment[]

  @@unique([tenantId, eventId, idempotencyKey])
  @@index([tenantId, eventId, status])
  @@index([tenantId, eventId, email])
  @@index([tenantId, eventId, whatsappNumber])
  @@index([tenantId, createdAt])
  @@map("registrations")
}

model RegistrationItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  ticketTypeId   String       @map("ticket_type_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal      @map("unit_price") @db.Decimal(18, 2)
  totalPrice     Decimal      @map("total_price") @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])
  ticketType     TicketType   @relation(fields: [ticketTypeId], references: [id])
  tickets        Ticket[]

  @@index([tenantId, registrationId])
  @@index([ticketTypeId])
  @@map("registration_items")
}

model RegistrationAddOn {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  addOnId        String       @map("add_on_id") @db.Uuid
  addOnOptionId  String?      @map("add_on_option_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal      @map("unit_price") @db.Decimal(18, 2)
  totalPrice     Decimal      @map("total_price") @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])
  addOn          AddOn        @relation(fields: [addOnId], references: [id])
  addOnOption    AddOnOption? @relation(fields: [addOnOptionId], references: [id])

  @@index([tenantId, registrationId])
  @@index([addOnId])
  @@map("registration_add_ons")
}

model RegistrationAnswer {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  registrationId    String       @map("registration_id") @db.Uuid
  formFieldId       String       @map("form_field_id") @db.Uuid
  answerJson        Json         @map("answer_json")
  fieldSnapshotJson Json?        @map("field_snapshot_json")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  registration      Registration @relation(fields: [registrationId], references: [id])
  formField         FormField    @relation(fields: [formFieldId], references: [id])

  @@unique([registrationId, formFieldId])
  @@index([tenantId, registrationId])
  @@map("registration_answers")
}

model Ticket {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  eventId            String           @map("event_id") @db.Uuid
  registrationId     String           @map("registration_id") @db.Uuid
  registrationItemId String           @map("registration_item_id") @db.Uuid
  ticketCode         String           @unique @map("ticket_code") @db.VarChar(48)
  qrTokenHash        String           @unique @map("qr_token_hash") @db.VarChar(128)
  holderName         String           @map("holder_name") @db.VarChar(160)
  holderEmail        String           @map("holder_email") @db.VarChar(320)
  status             String           @default("issued") @db.VarChar(24)
  issuedAt           DateTime         @default(now()) @map("issued_at") @db.Timestamptz(3)
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  event              Event            @relation(fields: [eventId], references: [id])
  registration       Registration     @relation(fields: [registrationId], references: [id])
  registrationItem   RegistrationItem @relation(fields: [registrationItemId], references: [id])
  checkIns           CheckIn[]

  @@index([tenantId, eventId, status])
  @@index([tenantId, createdAt])
  @@map("tickets")
}

model CheckIn {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  ticketId    String    @map("ticket_id") @db.Uuid
  checkedInBy String    @map("checked_in_by") @db.Uuid
  checkedInAt DateTime  @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  source      String    @default("web") @db.VarChar(24)
  deviceId    String?   @map("device_id") @db.VarChar(160)
  syncKey     String    @unique @map("sync_key") @db.VarChar(160)
  notes       String?
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy    String?   @map("voided_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  event       Event     @relation(fields: [eventId], references: [id])
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  actor       User      @relation("check_in_actor", fields: [checkedInBy], references: [id])
  voider      User?     @relation("check_in_voider", fields: [voidedBy], references: [id])

  @@index([tenantId, eventId, checkedInAt])
  @@index([tenantId, ticketId])
  @@map("check_ins")
}

model PaymentConfig {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String?   @map("tenant_id") @db.Uuid
  provider              String    @default("xendit") @db.VarChar(24)
  accountMode           String    @default("platform") @map("account_mode") @db.VarChar(24)
  environment           String    @default("test") @db.VarChar(16)
  businessId            String?   @map("business_id") @db.VarChar(160)
  secretApiKeyEncrypted String    @map("secret_api_key_encrypted")
  webhookTokenEncrypted String    @map("webhook_token_encrypted")
  apiVersion            String    @default("2024-11-11") @map("api_version") @db.VarChar(24)
  isDefault             Boolean   @default(false) @map("is_default")
  isActive              Boolean   @default(true) @map("is_active")
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)
  tenant                Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@map("payment_configs")
}

model Payment {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.Uuid
  registrationId           String       @map("registration_id") @db.Uuid
  provider                 String       @default("xendit") @db.VarChar(24)
  paymentMethod            String       @default("QRIS") @map("payment_method") @db.VarChar(32)
  referenceId              String       @unique @map("reference_id") @db.VarChar(160)
  providerPaymentRequestId String?      @unique @map("provider_payment_request_id") @db.VarChar(160)
  providerPaymentId        String?      @unique @map("provider_payment_id") @db.VarChar(160)
  providerBusinessId       String?      @map("provider_business_id") @db.VarChar(160)
  amount                   Decimal      @db.Decimal(18, 2)
  currency                 String       @default("IDR") @db.Char(3)
  status                   String       @default("pending") @db.VarChar(32)
  failureCode              String?      @map("failure_code") @db.VarChar(120)
  qrStringEncrypted        String?      @map("qr_string_encrypted")
  qrExpiresAt              DateTime?    @map("qr_expires_at") @db.Timestamptz(3)
  providerCreatedAt        DateTime?    @map("provider_created_at") @db.Timestamptz(3)
  paidAt                   DateTime?    @map("paid_at") @db.Timestamptz(3)
  expiredAt                DateTime?    @map("expired_at") @db.Timestamptz(3)
  lastCheckedAt            DateTime?    @map("last_checked_at") @db.Timestamptz(3)
  settledByUserId          String?      @map("settled_by_user_id") @db.Uuid
  manualReference          String?      @map("manual_reference") @db.VarChar(160)
  settlementNotes          String?      @map("settlement_notes")
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                   Tenant       @relation(fields: [tenantId], references: [id])
  registration             Registration @relation(fields: [registrationId], references: [id])
  settledBy                User?        @relation("payment_manual_settler", fields: [settledByUserId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([settledByUserId, paidAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String?   @map("tenant_id") @db.Uuid
  provider                 String    @default("xendit") @db.VarChar(24)
  eventName                String    @map("event_name") @db.VarChar(120)
  providerEventKey         String    @map("provider_event_key") @db.VarChar(255)
  providerPaymentId        String?   @map("provider_payment_id") @db.VarChar(160)
  providerPaymentRequestId String?   @map("provider_payment_request_id") @db.VarChar(160)
  referenceId              String?   @map("reference_id") @db.VarChar(160)
  payloadJson              Json      @map("payload_json")
  headersJsonMasked        Json      @map("headers_json_masked")
  status                   String    @default("received") @db.VarChar(32)
  processingError          String?   @map("processing_error")
  receivedAt               DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt              DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                   Tenant?   @relation(fields: [tenantId], references: [id])

  @@unique([provider, providerEventKey])
  @@index([tenantId, status])
  @@index([referenceId])
  @@map("payment_webhook_events")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role") @db.VarChar(32)
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.Uuid
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}
